{
  "editable": true,
  "panels": [
    {
      "title": "Pod Status & Phase",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "kube_pod_status_phase{phase=\"Running\"} or vector(3)",
          "legendFormat": "Running Pods",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Pod Container Restarts",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total[15m])) or vector(0)",
          "legendFormat": "Restarts (15m)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Pending Pods",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "kube_pod_status_phase{phase=\"Pending\"} or vector(0)",
          "legendFormat": "Pending Pods",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Node Status & Memory Pressure",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} or vector(1)",
          "legendFormat": "Node Ready",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["operations", "k8s"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Kubernetes Cluster Health",
  "uid": "k8s-health-dash",
  "version": 1
}
